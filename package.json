{
    "name": "reveal.js-multimodal",
    "version": "1.0.1",
    "description": "A plugin for Reveal.js to show modal windows in presentations",
    "keywords": [
        "reveal",
        "reveal.js",
        "reveal-plugin",
        "plugin",
        "modal",
        "lightbox",
        "powerpoint"
    ],
    "homepage": "https://github.com/martinomagnifico/reveal.js-multimodal",
    "license": "MIT",
    "author": {
        "name": "Martijn De Jongh (Martino)",
        "email": "martijn.de.jongh@gmail.com",
        "web": "https://martinomagnifico.github.io",
        "url": "https://martinomagnifico.github.io",
        "username": "martinomagnifico"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/martinomagnifico/reveal.js-multimodal.git"
    },
    "type": "module",
    "main": "./plugin/multimodal/multimodal.js",
    "module": "./plugin/multimodal/multimodal.mjs",
    "exports": {
        ".": {
            "import": "./plugin/multimodal/multimodal.mjs",
            "require": "./plugin/multimodal/multimodal.js"
        },
        "./plugin/multimodal/multimodal.esm.js": "./plugin/multimodal/multimodal.mjs",
        "./plugin/multimodal/multimodal.css": "./plugin/multimodal/multimodal.css",
        "./multimodal.css": "./plugin/multimodal/multimodal.css"
    },
    "style": "plugin/multimodal/multimodal.css",
    "files": [
        "plugin/multimodal"
    ],
    "scripts": {
        "start": "npm run dev",
        "copy-reveal": "node scripts/copy-reveal.mjs",
        "copy-plugin": "node scripts/copy-plugin.mjs",
        "dev": "vite",
        "prebuild": "rimraf demo plugin",
        "build-plugin": "vite build -c vite.lib.config.ts",
        "build-demo": "vite build -c vite.config.ts",
        "build": "npm run build-plugin && npm run build-demo && npm run copy-reveal && npm run copy-plugin",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check --write .",
        "preview": "npm run build && vite preview",
        "ci": "biome ci ."
    },
    "peerDependencies": {
        "reveal.js": ">=5.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@types/node": "^26.2.0",
        "@vituum/vite-plugin-pug": "^2.0.1",
        "body-scroll-lock-upgrade": "^1.1.0",
        "fs-extra": "^11.4.0",
        "marked": "^18.0.10",
        "reveal.js": "^6.0.1",
        "reveal.js-plugintoolkit": "^1.0.8",
        "rimraf": "^6.1.3",
        "sass": "^1.103.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vituum": "^2.0.2"
    }
}
