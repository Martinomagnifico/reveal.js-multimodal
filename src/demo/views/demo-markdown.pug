extends templates/layouts/_reveal.pug

append variables
	- presentation.title = presentation.title + ": using Markdown"

block slides
	include slides/_slides-markdown

block beforeslides
	+badge(plugin.name.toLowerCase(), 'bottom')

block append scripts
	+revealsrc("script", "dist/plugin/markdown.js")
	+revealsrc("script", "dist/plugin/highlight.js")
	+revealsrc("script", "dist/plugin/notes.js")

	if process.env.NODE_ENV === 'production'
		//- @vite-ignore
		script(src=`plugin/${plugin.name}/${plugin.name}.js`)
		script.
			Reveal.initialize({
				margin: 0.1, maxScale: 1.8, width: 1080, height: 700,
				history: true, center: true, controlsTutorial: false,
				plugins: [ RevealMarkdown, RevealHighlight, Multimodal, RevealNotes ]
			});
	else
		script(type="module").
			import Multimodal from '@/plugin/js/index';
			Reveal.initialize({
				margin: 0.1, maxScale: 1.8, width: 1080, height: 700,
				history: true, center: true, controlsTutorial: false,
				plugins: [ RevealMarkdown, RevealHighlight, Multimodal, RevealNotes ],
				multimodal: {
					debug: false
				}
			});
